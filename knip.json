{
  "workspaces": {
    ".": {},
    "packages/core": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@sinclair/typebox"],
      "ignore": ["src/tools/**"]
    },
    "packages/server": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@fastify/cors", "@fastify/helmet", "@sinclair/typebox"],
      "ignore": ["src/auth/**", "src/config.ts"]
    },
    "packages/mailmcp": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "ignore": [".claude/**"]
}
