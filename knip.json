{
  "workspaces": {
    ".": {
      "ignoreDependencies": ["bun-types"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@sinclair/typebox"]
    },
    "packages/imap": {
      "project": ["src/**/*.ts"]
    },
    "packages/smtp": {
      "project": ["src/**/*.ts"]
    },
    "packages/tools": {
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@fastify/cors", "@fastify/helmet", "@sinclair/typebox"],
      "ignore": ["src/auth/**", "src/config.ts"]
    },
    "packages/mailmcp": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "ignore": [".claude/**"]
}
