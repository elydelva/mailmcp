{
  "workspaces": {
    ".": {},
    "packages/core": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@sinclair/typebox", "@types/nodemailer", "imapflow", "nodemailer"],
      "ignore": [
        "src/imap/**",
        "src/providers/**",
        "src/smtp/**",
        "src/storage/postgres.ts",
        "src/tools/**"
      ]
    },
    "packages/server": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@fastify/cors", "@fastify/helmet", "@sinclair/typebox"],
      "ignore": ["src/auth/**", "src/config.ts"]
    },
    "packages/mailmcp": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@mailmcp/core"]
    }
  },
  "ignoreExportsUsedInFile": true
}
