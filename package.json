{
  "name": "mailmcp-monorepo",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.0.0",
      "@modelcontextprotocol/sdk": "^1.28.0"
    }
  },
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun run --cwd packages/server dev",
    "dev:inspect": "bun run --cwd packages/mailmcp dev:inspect",
    "build": "bun run --cwd packages/server build",
    "start": "bun run --cwd packages/server start",
    "test": "bun test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write",
      "biome format --write"
    ],
    "*.json": [
      "biome format --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@types/node": "^25.5.0",
    "bun-types": "^1.3.11",
    "husky": "^9.1.7",
    "knip": "^6.0.5",
    "lint-staged": "^16.4.0",
    "turbo": "^2.8.20",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "path-to-regexp": ">=8.4.0"
  }
}
