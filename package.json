{
  "name": "mailmcp",
  "version": "0.1.0",
  "description": "Self-hosted MCP email server with OAuth 2.1",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "knip": "knip"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@sinclair/typebox": "^0.34.48",
    "fastify": "^5.8.4",
    "imapflow": "^1.2.17",
    "lowdb": "^7.0.1",
    "nodemailer": "^8.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "bun-types": "^1.3.11",
    "knip": "^6.0.5",
    "typescript": "^6.0.2"
  }
}
