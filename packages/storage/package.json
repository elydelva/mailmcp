{
  "name": "@mailmcp/storage",
  "version": "0.4.2",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --build tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun run src/migrate.ts"
  },
  "dependencies": {
    "@mailmcp/crypto": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "lowdb": "^7.0.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
