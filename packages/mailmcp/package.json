{
  "name": "@mailmcp/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "mailmcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --minify",
    "dev": "bun run --watch src/index.ts",
    "start:mcp": "bun run src/index.ts --mcp",
    "typecheck": "tsc --build tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "@mailmcp/storage": "workspace:*",
    "@mailmcp/tools": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "pino": "^9.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "pino-pretty": "^12.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
