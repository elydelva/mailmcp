# Server
PORT=3000
HOST=0.0.0.0
BASE_URL=https://mcp.example.com

# OAuth / Hydra
HYDRA_PUBLIC_URL=https://auth.example.com
HYDRA_ADMIN_URL=http://hydra:4445
HYDRA_API_KEY=
HYDRA_SECRET=change-me-in-production
HYDRA_DOMAIN=auth.example.com
AUTH_UI_URL=https://auth-ui.example.com
AUTH_UI_DOMAIN=auth-ui.example.com

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Storage backend: postgres | file
STORAGE_BACKEND=postgres

# PostgreSQL
DATABASE_URL=postgresql://user:pass@localhost:5432/mailmcp
POSTGRES_PASSWORD=change-me
MCP_DB_PASSWORD=change-me
MCP_MAIL_DOMAIN=mcp.example.com

# File storage (used when STORAGE_BACKEND=file)
DATA_DIR=/data

# Limits
MAX_ACCOUNTS_PER_USER=10
MAX_EMAILS_PER_FETCH=100
IMAP_TIMEOUT_MS=30000
